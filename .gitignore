# ── Patient data (large, personal, never commit) ──
data/
archive/

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ── Claude context ──
.claude/

# ── macOS ──
.DS_Store

# ── Docker volumes (managed by Docker, not git) ──
phv-pgdata/
phv-osdata/
phv-aidata/

# ── SSL certs (self-signed, local only) ──
certs/

# ── Environment & secrets ──
.env
.env.local
!.env.example

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── Logs ──
*.log

# ── Temporary ──
*.tmp
*.bak

# Migration backups (large, contain personal data)
tmp/

# ── v2 rebuild ──
# Generated bundles + diff reports contain PHI from raw exports
tools/v2/out/
# Patient-specific config (clinician→org mappings) — committed only as .example
tools/v2/patient_config/org_mapping.json
tools/v2/patient_config/patient_identity.json

# ── v3 scraper ──
# Live scraped output (contains full clinical note HTML; never commit)
tools/v3/out/

# ── portal-scout ──
# Raw captures of XHRs / DOM snapshots from authenticated portal sessions.
# Used to reverse-engineer scrapers; contain PHI; never commit.
tools/portal-scout/captures/

# ── mobile/ (Flutter project — keep source, ignore build/Pods/etc) ──
mobile/.dart_tool/
mobile/build/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/macos/Pods/

# ── Backup credentials (never commit) ──
.binahealth-backup-env

# Mobile-bundled PHI asset (CSN list) — see scripts/sync-mobile-assets.sh.
# Ignore everything directly under mobile/assets/ but allow re-including
# subdirs below (git can't re-include a file whose parent dir is ignored,
# so we exclude files not the directory).
mobile/assets/*
# ...but portal configs are public info (URLs, hostnames, auth field
# names), tracked in git so the mobile app can build from a clean clone.
# Ingest-side per-portal metadata (FHIR patient refs etc.) lives in
# tools/portal_ingest_config.json — that one stays private.
!mobile/assets/portals/

# ── Portal ingest config (private per-portal FHIR refs) ──
tools/portal_ingest_config.json

# Local scratchpad / analysis files — may contain raw portal responses (PHI).
scratchpad-*.json
scratchpad/
