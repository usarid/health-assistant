# Cloudflare Tunnel config for Bina Health
# Copy this to ~/.cloudflared/config.yml after creating the tunnel
#
# Setup:
#   brew install cloudflared
#   cloudflared tunnel login                       # authorize the binahealth.com zone
#   cloudflared tunnel create binahealth
#   cp cloudflared/config.yml.example ~/.cloudflared/config.yml
#   # Edit the tunnel ID and credentials-file path below
#   cloudflared tunnel route dns binahealth binahealth.com
#   sudo cloudflared service install
#   sudo launchctl bootstrap system /Library/LaunchDaemons/com.cloudflare.cloudflared.plist

tunnel: TUNNEL_ID_HERE
credentials-file: /Users/YOUR_USERNAME/.cloudflared/TUNNEL_ID_HERE.json

ingress:
  - hostname: binahealth.com
    service: http://localhost:3080
    originRequest:
      noTLSVerify: false
  - service: http_status:404
