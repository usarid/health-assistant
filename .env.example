# Bina Health — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Model override ─────────────────────────────────────────
# Use the bare alias (claude-sonnet-4-6, claude-opus-4-8, etc.). Dated
# snapshot IDs (claude-sonnet-4-20250514, …) deprecate ~6-12 months
# after release and return 404 from the retirement date onward.
#
# Chat is latency-sensitive → Sonnet. Analyst is reasoning-heavy and
# latency-tolerant → Opus. Override either independently.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_ANALYST=claude-opus-4-8

# ── Optional: Local LLM (Ollama) for narrator summaries ──────────────
# OLLAMA_BASE=http://host.docker.internal:11434
# OLLAMA_MODEL=mistral

# ── Optional: Epic on FHIR OAuth (for live EHR access) ───────────────
# EPIC_CLIENT_ID=
# EPIC_CLIENT_SECRET=
# EPIC_REDIRECT_URI=https://binahealth.com/callback
